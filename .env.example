# Copy this file to .env and fill in your real values.
SESSION_ID=your_sessionid_here
CSRFTOKEN=your_csrf_token_here
NEXT_AUTH_SESSION_TOKEN=your_next_auth_session_token_here
CATEGORY_ID=your_category_id_here
SUBCATEGORY_ID=your_subcategory_id_here
MAX_CONCURRENT_COURSES=1

# chromium (includes chrome, brave, other) or firefox
BROWSER=chromium
